# Optional Telegram settings for notify.sh. Copy to notify.env (same folder) and fill in.
# Keep notify.env out of version control. With no token, notify.sh logs messages instead.
#
# 1. Create a bot with @BotFather and paste its token below.
# 2. Send your bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
